function automatic [SAVES_TITLE_WIDTH-1:0] saves_core_row;
    input [6:0] row;
    begin
        if (row < SAVES_TITLE_HEIGHT)
            saves_core_row = saves_core_rom[row];
        else
            saves_core_row = {SAVES_TITLE_WIDTH{1'b0}};
    end
endfunction

