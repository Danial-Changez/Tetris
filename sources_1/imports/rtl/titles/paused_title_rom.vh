function automatic [PAUSED_TITLE_WIDTH-1:0] paused_core_row;
    input [6:0] row;
    begin
        if (row < PAUSED_TITLE_HEIGHT)
            paused_core_row = paused_core_rom[row];
        else
            paused_core_row = {PAUSED_TITLE_WIDTH{1'b0}};
    end
endfunction

function automatic [PAUSED_TITLE_WIDTH-1:0] paused_shadow_row;
    input [6:0] row;
    begin
        if (row < PAUSED_TITLE_HEIGHT)
            paused_shadow_row = paused_shadow_rom[row];
        else
            paused_shadow_row = {PAUSED_TITLE_WIDTH{1'b0}};
    end
endfunction

