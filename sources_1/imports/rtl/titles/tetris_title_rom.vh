function automatic [TITLE_WIDTH-1:0] title_core_row;
    input [6:0] row;
    begin
        if (row < TITLE_HEIGHT)
            title_core_row = title_core_rom[row];
        else
            title_core_row = {TITLE_WIDTH{1'b0}};
    end
endfunction

function automatic [TITLE_WIDTH-1:0] title_shadow_row;
